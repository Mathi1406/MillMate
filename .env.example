# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=flourmill_db
PGUSER=postgres
PGPASSWORD=database_password
# Single administrator login (create your own strong password)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=Your_strong_Password
SESSION_SECRET=your_secret_key
COOKIE_SECURE=false
PORT=3000
